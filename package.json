{
  "name": "fine-ance",
  "version": "1.0.0",
  "description": "Fine-ance Fullstack Kişisel Finans Takip Uygulaması",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
